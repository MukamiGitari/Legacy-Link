# Supabase Credentials (Optional - app runs with rich local state if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Edge Function secrets (set in Supabase Dashboard → Settings → Edge Functions) ──
# These are SERVER-SIDE only. Never use VITE_ prefix — they must never reach the browser.
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Required by redeem-restoration-code
#                                                   # and super-admin-bootstrap functions.
#                                                   # Find it in Dashboard → Settings → API.
#
# BOOTSTRAP_SECRET=your-random-secret              # Required only for super-admin-bootstrap.
#                                                   # Use any strong random string (e.g. openssl rand -hex 32).
#                                                   # Remove after the first super_admin has been created.
